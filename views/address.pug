extends layout
include mixins

block content
  .page-head
    span.label ADDRESS
    span.hash= addr

  if isQuantumVulnerable
    .alert-inset
      span(style='color:var(--purple);font-weight:600') Quantum exposed:
      |  #{exposureText} A sufficiently powerful quantum computer could derive the private key#{exposureKind === 'p2ms' || exposureKind === 'script' || exposureKind === 'script-mixed' ? 's' : ''}.
      |
      span.chip.chip--purple= exposureChip
      if exposureKind === 'reuse'
        br
        if quantum.via
          | Revealed by a spend from #[a(href=`/address/${quantum.via}`, style='color:var(--secondary)')= quantum.via]#{quantum.block != null ? ' in block ' + num(quantum.block) : ''}.
        else
          | Public since #{quantum.block != null ? 'block ' + num(quantum.block) : 'an earlier block'}: seen in a P2PK, bare-multisig or revealed script, or at this key’s other encoding (compressed / uncompressed).
        if !quantum.recorded
          |  Found by checking this address against every public key; not yet reflected in the totals.
      each k in quantum.keys
        br
        span.hash(style='font-size:8.5px;color:var(--faded)') #{exposureKind === 'p2tr' ? 'output key' : 'pubkey'} #{k}
  else
    .note--italic
      if quantum.singleKeyType
        | No public key for this address is on-chain as of block #{quantum.asOfBlock != null ? num(quantum.asOfBlock) : '—'}. Checked: spends from this address, and the same key used anywhere else — at its P2PKH, P2WPKH and P2SH-P2WPKH addresses, compressed or uncompressed, and in P2PK, bare-multisig or revealed scripts. “Never spent” alone is not that check: a wallet can reuse one key across address types.
        if !quantum.fullCoverage
          |  (Partial: the index of keys seen in scripts and other encodings is still being built, so only spends from this address and its same-hash siblings were checked.)
        |  Not covered: keys disclosed off-chain, such as signed messages or an extended public key (xpub) shared with a wallet or service.
      else
        | No spend from this address has revealed its script or keys as of block #{quantum.asOfBlock != null ? num(quantum.asOfBlock) : '—'}. For a script address the keys inside may still be public elsewhere; a quantum attacker would also need the script itself.

  .rows(style='font-size:10px')
    .row.row--dotted
      span.k balance
      span(style='font-weight:600') #{btc8(totalBalance)} BTC
    .row.row--dotted
      span.k utxos
      span= num(totalUtxos)
    .row.row--dotted
      span.k first seen block
      span= addrInfo ? num(addrInfo.first_seen_block) : '—'
    .row.row--dotted
      span.k last active block
      span= addrInfo ? num(addrInfo.last_active_block) : '—'

  section.section.section--tight
    span.label UTXOS · LARGEST #{utxos.length} SHOWN
    .rows(style='font-size:10px')
      if utxos.length
        each u in utxos
          .event-row
            a.txid(href=`/transaction/${u.tx_hash}`)
              +ident(u.tx_hash, shortHash(u.tx_hash))
              |  : #{u.output_index}
            a.blk(href=`/block/${u.block_number}`)= num(u.block_number)
            each rule in u.loss_rules
              span.chip(class=ruleCategory(rule) === 'probable' ? 'chip--amber' : ruleCategory(rule) === 'quantum' ? 'chip--purple' : 'chip--red')= ruleChip(rule)
            if u.pubkey_exposed && !u.loss_rules.length
              span.chip.chip--purple Q-EXPOSED
            span.amt= btc8(u.value_sats)
      else
        .row.row--dotted.row--zero no unspent outputs at this address
